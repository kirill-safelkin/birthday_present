# Виртуальное окружение
.venv/

# Кэш и байт-код Python
__pycache__/
*.py[cod]

# Кэши и отчёты инструментов проверки
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Файлы IDE и редакторов
.idea/
.vscode/
*.swp
*~
.DS_Store

# Локальные настройки Claude Code и секреты
.claude/settings.local.json
.env
.env.*
!.env.example
*.pem
*.key

# Логи, временные файлы и сборка
*.log
*.tmp
*.bak
build/
dist/

# Тяжёлые исходные генерации персонажей (2–3 МБ): лежат в art/ только локально
art/characters/*/*_source_sheet.png
art/characters/*/*_with_checkerboard.png
